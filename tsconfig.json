{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowJs": false,
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["dom", "esnext"],
    "types": ["react", "vite/client"],
    "baseUrl": "./src",
    "paths": {
      "@components/*": ["client/components/*"],
      "@assets/*": ["client/assets/*"],
      "@pages/*": ["client/pages/*"],
      "@hooks/*": ["client/hooks/*"],
      "@constants/*": ["client/constants/*"],
      "@typings/*": ["client/typings/*"],
      "@services/*": ["client/services/*"],
      "@routes/*": ["client/routes/*"],
      "@utils/*": ["client/utils/*"],
      "@mocks/*": ["client/mocks/*"],
      "@recoil/*": ["client/recoil/*"],
      "@admin/*": ["admin/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["src"]
}
